+    def _route(self, sentence):
+        """Single-pass max-probability route (optimization, see PATCH.md).
+
+        Replaces the get_DAG() + calc() pair used by the accurate-mode cutters
+        with one backward scan. The original does the same substring work twice:
+        get_DAG() tests ``frag in FREQ`` to discover edges, then calc() slices
+        the same spans again and looks the frequency up a second time. Here the
+        frequency is read once while scanning, and the Viterbi recurrence is
+        applied immediately, so no per-position edge list is materialised.
+
+        Returns (values, ends) as two flat lists:
+          values[idx] -- log P(best route from idx to end), values[N] == 0.0
+          ends[idx]   -- the inclusive end offset of the first word on that
+                         route, i.e. the original route[idx][1].
+
+        Equivalent to:
+            route = {}; calc(sentence, get_DAG(sentence), route)
+        for every input, including tie-breaking: the original compares
+        (value, end) tuples, so an exact tie picks the larger end offset.
+
+        The arithmetic is deliberately written in the original's order,
+        ``log(freq) - logtotal + values[i + 1]``. Regrouping it as
+        ``log(freq) + values[i + 1] - logtotal`` is algebraically identical but
+        not bit-identical in IEEE-754, and that difference is observable: for
+        inputs such as "期期期" two routes have mathematically equal scores, so
+        the rounding of the last bit decides which one wins the tie. Keeping
+        the original association reproduces the original segmentation exactly.
+        """
+        N = len(sentence)
+        # get_DAG() used to perform this check on the caller's behalf; without
+        # it, a first call to cut() would read self.total == 0 and log(0).
+        self.check_initialized()
+        FREQ = self.FREQ
+        logtotal = log(self.total)
+        get = FREQ.get
+
+        values = [0.0] * (N + 1)
+        ends = [0] * N
+
+        for idx in xrange(N - 1, -1, -1):
+            best = _NEG_INF
+            best_end = idx
+            found = False
+            i = idx
+            frag = sentence[idx]
+            while i < N:
+                freq = get(frag)
+                if freq is None:
+                    break
+                if freq:
+                    found = True
+                    # Same association as the original: (log - logtotal) + prev.
+                    value = log(freq) - logtotal + values[i + 1]
+                    if value >= best:
+                        best = value
+                        best_end = i
+                i += 1
+                frag = sentence[idx:i + 1]
+            if not found:
+                # No dictionary word starts here; the only edge is the single
+                # character with an implicit frequency of 1 (log == 0.0).
+                best = 0.0 - logtotal + values[idx + 1]
+            values[idx] = best
+            ends[idx] = best_end
+
+        return values, ends
+
